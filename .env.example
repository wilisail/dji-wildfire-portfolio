# Contentful Space settings. The Blog starter's content type API ID is pageBlogPost.
CONTENTFUL_SPACE_ID=YOUR_SPACE_ID
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_LOCALE=en-US

# Server-only Contentful tokens. Never use a VITE_ prefix or commit real tokens.
CONTENTFUL_DELIVERY_TOKEN=YOUR_DELIVERY_API_TOKEN
CONTENTFUL_MANAGEMENT_TOKEN=YOUR_CONTENT_MANAGEMENT_TOKEN

# One website editor account. These are separate from the Contentful account.
EDITOR_EMAIL=editor@example.com
EDITOR_NAME=Portfolio Editor
EDITOR_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Server-only session signing key. Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS

# Final public origin, used for canonical links and the sitemap.
SITE_ORIGIN=https://YOUR-PROJECT.vercel.app
