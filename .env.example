# Public Backendless application origin; never use your console password here.
BACKENDLESS_BASE_URL=https://YOUR-APP.backendless.app/api
# Server-only session signing key. Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
# Optional final production origin for canonical links and sitemap generation.
SITE_ORIGIN=https://YOUR-PROJECT.vercel.app
